# Where data comes from: "mock" (in-browser database seeded from src/data) or "api" (REST backend).
VITE_DATA_SOURCE=mock

# Base URL of the REST backend, used when VITE_DATA_SOURCE=api.
VITE_API_BASE_URL=/api

# Simulated network latency for mock services, in milliseconds.
VITE_MOCK_LATENCY_MIN=150
VITE_MOCK_LATENCY_MAX=600

# Probability (0 to 1) that a mock request fails, to exercise error states. Keep 0 outside development.
VITE_MOCK_ERROR_RATE=0

# Pin the clock for demos and tests: "HH:mm" (today at that time) or an ISO date-time. Empty = real time.
VITE_FIXED_NOW=

# How fast a pinned clock runs: 1 = real time, 5 = five times faster, 0 = frozen.
VITE_CLOCK_SPEED=1
